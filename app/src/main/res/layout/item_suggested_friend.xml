<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:padding="8dp">

    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrier_avatar"
        app:barrierDirection="end"
        app:constraint_referenced_ids="iv_suggest_fr_avatar"
        android:layout_height="match_parent"
        android:layout_width="wrap_content"/>

    <de.hdodenhof.circleimageview.CircleImageView
        android:id="@+id/iv_suggest_fr_avatar"
        android:layout_width="@dimen/mar_80"
        android:layout_height="@dimen/mar_80"
        android:src="@raw/owl_default_avatar"
        app:civ_border_color="@color/my_alice_blue"
        app:civ_border_width="2dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


    <!-- Thông tin -->
    <LinearLayout
        android:id="@+id/linearLayout12"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="@dimen/pad_20"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/iv_suggest_fr_avatar"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tv_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Quang Nguyễn"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_mutual_friends"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="37 bạn chung • 25 tuần"
            android:textColor="#888888"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/linearLayout13"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginStart="@dimen/pad_20"
        app:layout_constraintStart_toEndOf="@+id/iv_suggest_fr_avatar"
        app:layout_constraintTop_toBottomOf="@+id/linearLayout12">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_add_friend"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="#007BFF"
            android:text="Thêm bạn bè"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_reject"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="#888888"
            android:text="Gỡ"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
